# ===========================================================================
# qlapp .gitignore
# 目标：仓库公开，绝不把「只有你自己该有的东西」提交上去。
# 凡是含密钥、域名、账号 ID、本机路径、构建产物、临时调试文件的，全部排除。
# ===========================================================================

# ------------------------------ 私有配置 ------------------------------
# 后端地址 / 共享密钥 / 纪念日 —— 只存在本机，仓库里只保留 *.example
keys.properties
# 真实的 wrangler.toml（含 D1 database_id、KV id、自定义域名）→ 只提交 .example
backend/wrangler.toml
# 本机 SDK 路径
local.properties

# ------------------------------ 个人运维笔记 ------------------------------
# 含真实域名、账号、密钥，属于本机运维记录，不公开
DEPLOY.md
DOMAIN-GUIDE.md
C盘清理方案.md
.game-window.xml

# ------------------------------ 域名/账号专属脚本 ------------------------------
# 这些脚本写死了本人 Cloudflare 账号 ID 或域名，只对本人有用。
# 别人用 workers.dev 默认地址就够，不需要这些。
backend/create-zone.mjs
backend/register-subdomain.mjs
backend/wait-and-bind.mjs
backend/dns-check.mjs
backend/monitor.ps1

# ------------------------------ 临时/调试文件 ------------------------------
# 本人所有临时脚本、日志、备份、探针文件统一以 _ 开头
_*
*.log

# ------------------------------ 构建产物 / APK ------------------------------
*.apk
*.aab
*.keystore
*.jks
/build
/app/build
build/
captures/
.externalNativeBuild
.cxx

# ------------------------------ IDE / 工具链 ------------------------------
.gradle
.kotlin
.idea
.workbuddy
*.iml
.DS_Store

# ------------------------------ 依赖 ------------------------------
node_modules/
backend/.wrangler/

# ------------------------------ 敏感备份 ------------------------------
# 导出的真实数据（日记/留言备份等）
backend/_backup_*
*_backup_*.json
